{
  "name": "cbl-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents query and edit the live Couchbase Lite database inside a running Android app (via the cbl-bridge debug library and adb).",
  "type": "module",
  "bin": {
    "cbl-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
