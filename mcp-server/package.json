{
  "name": "@couchbase-ecosystem/cblite-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents query and edit the live Couchbase Lite database inside a running Android app (debug builds, via adb and the cbl-bridge library).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "couchbase",
    "couchbase-lite",
    "android",
    "adb",
    "ai",
    "agents",
    "claude"
  ],
  "homepage": "https://github.com/Couchbase-Ecosystem/cblite-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Couchbase-Ecosystem/cblite-mcp.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Couchbase-Ecosystem/cblite-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "cblite-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
